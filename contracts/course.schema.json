{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/furuhashilab/2026gsc_TomoyaAiko/contracts/course.schema.json",
  "title": "CircuitForge Course",
  "description": "A fictional motorsport course on real OSM roads, stored as one GeoJSON Feature (RFC 7946, WGS84 lon/lat). The ordered segments are the source of truth; geometry and length are derived from them and checked by the validator.",
  "type": "object",
  "required": ["type", "geometry", "properties"],
  "properties": {
    "type": { "const": "Feature" },
    "geometry": {
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "LineString" },
        "coordinates": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "prefixItems": [
              { "type": "number", "minimum": -180, "maximum": 180 },
              { "type": "number", "minimum": -90, "maximum": 90 },
              { "type": "number" }
            ]
          }
        }
      }
    },
    "properties": {
      "type": "object",
      "required": [
        "schema", "schema_version", "id", "name", "mode", "fictional", "aoi",
        "osm_snapshot", "rule_set", "segments", "length_m", "authoring", "attribution",
        "disclaimer"
      ],
      "properties": {
        "schema": { "const": "circuitforge-course" },
        "schema_version": { "type": "string", "pattern": "^0\\.1\\.[0-9]+$" },
        "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["circuit", "rally"] },
        "fictional": { "const": true },
        "synthetic": { "type": "boolean", "description": "true when the roads are hand-made test data, not OSM" },
        "aoi": {
          "type": "object",
          "required": ["id", "bbox", "length_crs"],
          "properties": {
            "id": { "type": "string" },
            "bbox": {
              "type": "array",
              "description": "lon_min, lat_min, lon_max, lat_max (WGS84)",
              "minItems": 4,
              "maxItems": 4,
              "items": { "type": "number" }
            },
            "length_crs": { "type": "string", "description": "projected CRS in metres used for length_m" }
          }
        },
        "osm_snapshot": {
          "type": "object",
          "required": ["attic_date", "element_sha256", "profile"],
          "properties": {
            "attic_date": { "type": "string" },
            "element_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "profile": { "type": "string" }
          }
        },
        "rule_set": { "type": "string" },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["edge_uid", "way_id", "from_node", "to_node"],
            "properties": {
              "edge_uid": {
                "type": "string",
                "description": "way_id:segment_index:f|r (f = drawn order, r = against it)",
                "pattern": "^-?[0-9]+:[0-9]+:[fr]$"
              },
              "way_id": { "type": "integer" },
              "from_node": { "type": "integer" },
              "to_node": { "type": "integer" }
            },
            "additionalProperties": false
          }
        },
        "length_m": { "type": "number", "exclusiveMinimum": 0 },
        "preferences": {
          "type": "object",
          "properties": {
            "length_range_m": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "type": "number", "minimum": 0 }
            }
          }
        },
        "authoring": {
          "type": "object",
          "required": ["method", "tool"],
          "properties": {
            "method": { "enum": ["manual-via-points", "manual-segments"] },
            "via": { "type": "array" },
            "path_completion": { "type": "string" },
            "tool": { "type": "string" }
          }
        },
        "validation": {
          "type": "object",
          "description": "Written by the validator for display only; never trusted on read.",
          "required": ["status", "errors", "warnings", "validator"],
          "properties": {
            "status": { "enum": ["valid", "invalid"] },
            "errors": { "type": "array" },
            "warnings": { "type": "array" },
            "validator": { "type": "string" }
          }
        },
        "attribution": { "type": "string" },
        "disclaimer": { "type": "string" }
      }
    }
  }
}

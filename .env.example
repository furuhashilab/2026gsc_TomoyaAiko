# Copy to web/.env.local only if needed. Never commit real tokens (.env and .env.* are gitignored).
# Variables prefixed with VITE_ are embedded into the browser bundle, so treat them as public.

# Optional. Not used in Issue #5: the viewer runs without Cesium ion (GSI tiles, ellipsoid terrain).
# Reserved for a later issue if Cesium ion terrain/assets are adopted.
VITE_CESIUM_ION_TOKEN=
